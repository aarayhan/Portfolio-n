# Salin file ini jadi .env.local lalu isi dari Supabase: Project Settings > API Keys (publishable key, BUKAN secret key).
# Nama lama NEXT_PUBLIC_SUPABASE_ANON_KEY juga masih diterima.
# Kalau dikosongkan, web memakai isi bawaan (src/content/seed.ts) dan dashboard tidak aktif.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
